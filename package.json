{
  "name": "pitchview",
  "version": "1.2.2",
  "description": "PitchView — Minimal multi-view football player",
  "author": "WhyAlwaysEng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WhyAlwaysEng/PitchView.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/ci-run.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.pitchview.app",
    "productName": "PitchView",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "app.js",
      "style.css",
      "popout.html",
      "shared/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PitchView"
    },
    "publish": {
      "provider": "github",
      "owner": "WhyAlwaysEng",
      "repo": "PitchView",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^24.13.3",
    "playwright-core": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
